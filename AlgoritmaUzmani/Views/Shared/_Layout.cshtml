@inject AlgoritmaUzmani.Services.Interfaces.ISiteSettingService SiteSettingService
@{
    var language = ViewBag.Language ?? "tr";
    var isEnglish = language == "en";
    var siteName = isEnglish ? "Algorithm Expert" : "Algoritma Uzmanı";
    
    string googleAnalytics = "";
    string googleTagManager = "";
    string headerScripts = "";
    
    try
    {
        googleAnalytics = await SiteSettingService.GetValueAsync("google_analytics") ?? "";
        googleTagManager = await SiteSettingService.GetValueAsync("google_tag_manager") ?? "";
        headerScripts = await SiteSettingService.GetHeaderScriptsAsync() ?? "";
    }
    catch (Exception)
    {
        // Site settings servisi başarısız olsa bile sayfa render edilsin
    }
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewBag.MetaDescription" />
    @if (ViewBag.MetaKeywords != null)
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }
    
    <!-- SEO -->
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.CanonicalUrl" />
    @if (ViewBag.AlternateUrl != null)
    {
        <link rel="alternate" hreflang="@(isEnglish ? "tr" : "en")" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.AlternateUrl" />
        <link rel="alternate" hreflang="@language" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.CanonicalUrl" />
    }
    
    @* Google Analytics *@
    @if (!string.IsNullOrEmpty(googleAnalytics))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@googleAnalytics"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@googleAnalytics');
        </script>
    }
    
    @* Google Tag Manager *@
    @if (!string.IsNullOrEmpty(googleTagManager))
    {
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','@googleTagManager');</script>
    }
    
    @* Custom Header Scripts *@
    @Html.Raw(headerScripts)
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #f5b800;
            --primary-dark: #d9a400;
            --primary-light: #fff8dc;
            --primary-hover: #e6ac00;
            --secondary: #1a1a2e;
            --text: #16213e;
            --text-light: #6b7280;
            --text-muted: #9ca3af;
            --bg: #ffffff;
            --bg-soft: #fafafa;
            --bg-sidebar: #fcfcfc;
            --border: #e8e8e8;
            --border-light: #f0f0f0;
            --success: #22c55e;
            --info: #3b82f6;
            --warning: #f59e0b;
            --danger: #ef4444;
            
            /* Category Colors */
            --cat-ai: #8b5cf6;
            --cat-data: #06b6d4;
            --cat-security: #10b981;
            --cat-ecommerce: #f97316;
            --cat-file: #6366f1;
            --cat-image: #ec4899;
            --cat-seo: #14b8a6;
            --cat-hr: #f43f5e;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--text);
            background: var(--bg);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* ============================================
           HEADER - ApyHub Style
        ============================================ */
        .header {
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            flex-shrink: 0;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: var(--primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            box-shadow: 0 2px 8px rgba(245, 184, 0, 0.3);
        }

        .logo-text {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text);
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .nav-link {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text);
            border-radius: 6px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .nav-link:hover {
            background: var(--bg-soft);
            color: var(--text);
        }

        .nav-link.active {
            color: var(--primary-dark);
            position: relative;
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -1.25rem;
            left: 1rem;
            right: 1rem;
            height: 3px;
            background: var(--primary);
            border-radius: 3px 3px 0 0;
        }

        .nav-link .dropdown-icon {
            font-size: 0.625rem;
            opacity: 0.5;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap;
        }

        .btn-ghost {
            background: transparent;
            color: var(--text);
        }

        .btn-ghost:hover {
            background: var(--bg-soft);
        }

        .btn-primary {
            background: var(--primary);
            color: var(--secondary);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            box-shadow: 0 4px 12px rgba(245, 184, 0, 0.35);
        }

        .theme-toggle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: transparent;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-light);
            transition: all 0.15s ease;
        }

        .theme-toggle:hover {
            border-color: var(--text-light);
            color: var(--text);
        }

        /* ============================================
           MAIN LAYOUT
        ============================================ */
        .main-layout {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: 240px 1fr;
            gap: 2.5rem;
            min-height: calc(100vh - 64px - 200px);
        }

        /* ============================================
           SIDEBAR - ApyHub Style
        ============================================ */
        .sidebar {
            padding: 1.5rem 0;
            position: sticky;
            top: 80px;
            height: fit-content;
            max-height: calc(100vh - 100px);
            overflow-y: auto;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0 0 1rem;
            margin-bottom: 0.5rem;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-header-icon {
            font-size: 1.125rem;
        }

        .sidebar-title {
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text);
        }

        .category-section {
            padding: 0.75rem 0;
        }

        .category-section-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text);
            cursor: pointer;
            border-radius: 6px;
            transition: background 0.15s ease;
        }

        .category-section-title:hover {
            background: var(--bg-soft);
        }

        .category-section-title .chevron {
            font-size: 0.625rem;
            color: var(--text-light);
            transition: transform 0.2s ease;
        }

        .category-section.open .chevron {
            transform: rotate(180deg);
        }

        .category-list {
            list-style: none;
            margin-top: 0.25rem;
        }

        .category-item {
            margin: 2px 0;
        }

        .category-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-light);
            border-radius: 6px;
            transition: all 0.15s ease;
        }

        .category-link:hover {
            background: var(--bg-soft);
            color: var(--text);
        }

        .category-link.active {
            background: var(--primary-light);
            color: var(--text);
        }

        .category-icon {
            font-size: 1.125rem;
            width: 22px;
            text-align: center;
            flex-shrink: 0;
        }

        .category-name {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .category-count {
            font-size: 0.8125rem;
            color: var(--text-muted);
            font-weight: 500;
            min-width: 24px;
            text-align: right;
        }

        /* ============================================
           CONTENT AREA
        ============================================ */
        .content {
            padding: 1.5rem 0 3rem;
            min-width: 0;
        }

        .page-header {
            margin-bottom: 1.5rem;
        }

        .page-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.25rem;
        }

        .page-description {
            font-size: 0.9375rem;
            color: var(--text-light);
        }

        /* ============================================
           SEARCH BOX - ApyHub Style
        ============================================ */
        .search-section {
            margin-bottom: 2rem;
        }

        .search-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.625rem;
            display: block;
        }

        .search-box {
            display: flex;
            gap: 0.75rem;
            align-items: stretch;
        }

        .search-input-wrapper {
            flex: 1;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.75rem;
            font-size: 0.9375rem;
            font-family: inherit;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            outline: none;
            transition: all 0.15s ease;
        }

        .search-input::placeholder {
            color: var(--text-muted);
        }

        .search-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(245, 184, 0, 0.15);
        }

        .search-btn {
            padding: 0 1.5rem;
            background: var(--primary);
            color: var(--secondary);
            font-size: 0.9375rem;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .search-btn:hover {
            background: var(--primary-hover);
            box-shadow: 0 4px 12px rgba(245, 184, 0, 0.35);
        }

        .search-results {
            position: absolute;
            top: calc(100% + 0.5rem);
            left: 0;
            right: 0;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
            z-index: 1000;
            display: none;
            max-height: 400px;
            overflow-y: auto;
        }

        .search-results.active {
            display: block;
            animation: slideDown 0.2s ease;
        }

        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .search-result-item {
            display: flex;
            align-items: flex-start;
            gap: 0.875rem;
            padding: 0.875rem 1rem;
            border-bottom: 1px solid var(--border-light);
            transition: background 0.15s ease;
            cursor: pointer;
        }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .search-result-item:hover {
            background: var(--bg-soft);
        }

        .search-result-icon {
            width: 36px;
            height: 36px;
            background: var(--primary-light);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .search-result-content {
            flex: 1;
            min-width: 0;
        }

        .search-result-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.125rem;
        }

        .search-result-meta {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .search-no-results,
        .search-loading {
            padding: 1.5rem;
            text-align: center;
            color: var(--text-light);
            font-size: 0.9rem;
        }

        /* ============================================
           FILTER OPTIONS
        ============================================ */
        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text);
        }

        .filter-options {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .filter-checkbox {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-light);
            cursor: pointer;
        }

        .filter-checkbox input {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
            cursor: pointer;
        }

        /* ============================================
           GUIDE CARDS - ApyHub Style
        ============================================ */
        .guide-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
        }

        .guide-card {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.25rem;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .guide-card:hover {
            border-color: var(--border);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            transform: translateY(-2px);
        }

        .guide-card-header {
            display: flex;
            align-items: flex-start;
            gap: 0.875rem;
            margin-bottom: 0.875rem;
        }

        .guide-icon {
            width: 42px;
            height: 42px;
            background: var(--primary-light);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .guide-title-wrapper {
            flex: 1;
            min-width: 0;
        }

        .guide-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 0.25rem;
            transition: color 0.15s ease;
        }

        .guide-card:hover .guide-title {
            color: var(--primary-dark);
        }

        .guide-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            font-size: 0.6875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-radius: 4px;
            background: var(--bg-soft);
        }

        .guide-badge.featured {
            background: #fef3c7;
            color: #92400e;
        }

        .guide-badge-icon {
            width: 14px;
            height: 14px;
            background: var(--primary);
            border-radius: 3px;
            font-size: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .guide-category-tag {
            display: inline-block;
            padding: 0.3125rem 0.625rem;
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-radius: 4px;
            margin-bottom: 0.75rem;
        }

        .guide-category-tag.ai { background: #f3e8ff; color: #7c3aed; }
        .guide-category-tag.data { background: #e0f2fe; color: #0284c7; }
        .guide-category-tag.security { background: #d1fae5; color: #059669; }
        .guide-category-tag.ecommerce { background: #ffedd5; color: #c2410c; }
        .guide-category-tag.file { background: #e0e7ff; color: #4f46e5; }
        .guide-category-tag.image { background: #fce7f3; color: #be185d; }
        .guide-category-tag.seo { background: #ccfbf1; color: #0d9488; }
        .guide-category-tag.default { background: var(--primary-light); color: var(--primary-dark); }

        .guide-summary {
            font-size: 0.875rem;
            color: var(--text-light);
            line-height: 1.6;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
            margin-bottom: 1rem;
        }

        .guide-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 0.875rem;
            border-top: 1px solid var(--border-light);
            margin-top: auto;
        }

        .guide-author {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .guide-author-avatar {
            width: 24px;
            height: 24px;
            background: var(--primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .guide-author-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 6px;
            object-fit: cover;
        }

        .guide-author-name {
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--text);
        }

        .guide-author-verified {
            color: var(--info);
            font-size: 0.75rem;
        }

        .guide-stats {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .guide-stats-icon {
            font-size: 0.875rem;
        }

        /* ============================================
           FEATURED SECTION
        ============================================ */
        .featured-card {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            border: 1px solid #fcd34d;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2rem;
            align-items: center;
        }

        .featured-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            font-size: 0.75rem;
            font-weight: 700;
            background: var(--primary);
            color: var(--secondary);
            border-radius: 9999px;
            margin-bottom: 1rem;
        }

        .featured-badge::before {
            content: '✨';
        }

        .featured-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .featured-summary {
            font-size: 0.9375rem;
            color: var(--text-light);
            margin-bottom: 1.25rem;
            line-height: 1.7;
        }

        .featured-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.25rem;
            font-size: 0.9375rem;
            font-weight: 600;
            background: var(--bg);
            color: var(--text);
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.15s ease;
        }

        .featured-link:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
            transform: translateY(-1px);
        }

        .featured-image {
            width: 200px;
            height: 150px;
            border-radius: 12px;
            object-fit: cover;
            background: var(--bg);
            border: 3px solid var(--bg);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        }

        /* ============================================
           GUIDE DETAIL
        ============================================ */
        .guide-content {
            max-width: 800px;
        }

        .guide-content h1 { font-size: 2rem; margin-bottom: 1rem; }
        .guide-content h2 { font-size: 1.5rem; margin: 2rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
        .guide-content h3 { font-size: 1.25rem; margin: 1.5rem 0 0.75rem; }
        .guide-content h4 { font-size: 1.1rem; margin: 1.25rem 0 0.5rem; }
        .guide-content p { margin-bottom: 1rem; }
        .guide-content ul, .guide-content ol { margin: 1rem 0; padding-left: 1.5rem; }
        .guide-content li { margin-bottom: 0.5rem; }
        .guide-content blockquote {
            margin: 1.5rem 0;
            padding: 1rem 1.5rem;
            background: var(--primary-light);
            border-left: 4px solid var(--primary);
            border-radius: 0 8px 8px 0;
        }
        .guide-content pre {
            margin: 1.5rem 0;
            padding: 1rem;
            background: #1e293b;
            color: #e2e8f0;
            border-radius: 8px;
            overflow-x: auto;
            font-family: 'Fira Code', 'Monaco', monospace;
            font-size: 0.9rem;
        }
        .guide-content code {
            padding: 0.125rem 0.375rem;
            background: var(--bg-soft);
            border-radius: 4px;
            font-family: 'Fira Code', 'Monaco', monospace;
            font-size: 0.9em;
        }
        .guide-content pre code {
            padding: 0;
            background: transparent;
        }
        .guide-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1rem 0;
        }
        .guide-content a {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        /* Breadcrumb */
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-light);
            margin-bottom: 1.5rem;
        }

        .breadcrumb a:hover {
            color: var(--primary-dark);
        }

        .breadcrumb-sep {
            color: var(--border);
        }

        /* Related Guides */
        .related-section {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }

        .related-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        /* ============================================
           FOOTER
        ============================================ */
        .footer {
            margin-top: 4rem;
            background: var(--bg-soft);
            border-top: 1px solid var(--border);
        }

        .footer-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 3rem 2rem 2rem;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 2rem;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.625rem;
        }

        .footer-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .footer-logo-text {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
        }

        .footer-description {
            font-size: 0.875rem;
            color: var(--text-light);
            line-height: 1.6;
        }

        .footer-social {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .footer-social-link {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-light);
            transition: all 0.15s ease;
        }

        .footer-social-link:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: var(--secondary);
        }

        .footer-section h4 {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 1rem;
        }

        .footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.625rem;
        }

        .footer-links a {
            font-size: 0.875rem;
            color: var(--text-light);
            transition: color 0.15s ease;
        }

        .footer-links a:hover {
            color: var(--primary-dark);
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.8125rem;
            color: var(--text-light);
        }

        .footer-bottom-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-bottom-links a {
            color: var(--text-light);
            transition: color 0.15s ease;
        }

        .footer-bottom-links a:hover {
            color: var(--primary-dark);
        }

        /* ============================================
           COOKIE CONSENT
        ============================================ */
        .cookie-consent {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--secondary);
            color: #fff;
            padding: 1rem 1.5rem;
            z-index: 9999;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
        }

        .cookie-consent-inner {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .cookie-consent-text {
            margin: 0;
            font-size: 0.875rem;
            line-height: 1.5;
        }

        .cookie-link {
            color: var(--primary);
            text-decoration: underline;
        }

        .cookie-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .cookie-btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 6px;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
        }

        .cookie-btn-accept {
            background: var(--primary);
            color: var(--secondary);
        }

        .cookie-btn-decline {
            background: transparent;
            color: #94a3b8;
            border: 1px solid #475569;
        }

        /* ============================================
           MOBILE RESPONSIVE
        ============================================ */
        .mobile-menu-btn {
            display: none;
            background: none;
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 0.5rem;
            cursor: pointer;
            color: var(--text);
        }

        @@media (max-width: 1024px) {
            .guide-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .header-inner {
                padding: 0 1rem;
            }

            .nav {
                display: none;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .main-layout {
                grid-template-columns: 1fr;
                padding: 0 1rem;
                gap: 1.5rem;
            }

            .sidebar {
                position: relative;
                top: 0;
                display: none;
                padding: 1rem;
                background: var(--bg-soft);
                border-radius: 10px;
                margin-top: 1rem;
            }

            .sidebar.show {
                display: block;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 2rem;
                text-align: center;
            }

            .footer-brand {
                align-items: center;
            }

            .footer-social {
                justify-content: center;
            }

            .footer-links {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: center;
                gap: 1rem;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }

        @@media (max-width: 768px) {
            .guide-grid {
                grid-template-columns: 1fr;
            }

            .featured-card {
                grid-template-columns: 1fr;
                padding: 1.5rem;
            }

            .featured-image {
                width: 100%;
                height: 180px;
                order: -1;
            }

            .search-box {
                flex-direction: column;
            }

            .search-btn {
                padding: 0.75rem;
            }

            .filter-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 480px) {
            .header-inner {
                height: 56px;
            }

            .logo-text {
                display: none;
            }

            .header-actions .btn span {
                display: none;
            }

            .page-title {
                font-size: 1.5rem;
            }

            .cookie-consent-inner {
                flex-direction: column;
                text-align: center;
            }
        }

        /* Utilities */
        .text-muted { color: var(--text-light); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header">
