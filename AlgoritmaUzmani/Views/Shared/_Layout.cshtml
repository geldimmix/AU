@inject AlgoritmaUzmani.Services.Interfaces.ISiteSettingService SiteSettingService
@{
    var language = ViewBag.Language ?? "tr";
    var isEnglish = language == "en";
    var siteName = isEnglish ? "Algorithm Expert" : "Algoritma Uzmanı";
    
    string googleAnalytics = "";
    string googleTagManager = "";
    string headerScripts = "";
    
    try
    {
        googleAnalytics = await SiteSettingService.GetValueAsync("google_analytics") ?? "";
        googleTagManager = await SiteSettingService.GetValueAsync("google_tag_manager") ?? "";
        headerScripts = await SiteSettingService.GetHeaderScriptsAsync() ?? "";
    }
    catch (Exception)
    {
    }
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewBag.MetaDescription" />
    @if (ViewBag.MetaKeywords != null)
    {
        <meta name="keywords" content="@ViewBag.MetaKeywords" />
    }
    
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.CanonicalUrl" />
    @if (ViewBag.AlternateUrl != null)
    {
        <link rel="alternate" hreflang="@(isEnglish ? "tr" : "en")" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.AlternateUrl" />
        <link rel="alternate" hreflang="@language" href="@(Context.Request.Scheme)://@(Context.Request.Host)@ViewBag.CanonicalUrl" />
    }
    
    @if (!string.IsNullOrEmpty(googleAnalytics))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@googleAnalytics"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@googleAnalytics');
        </script>
    }
    
    @if (!string.IsNullOrEmpty(googleTagManager))
    {
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','@googleTagManager');</script>
    }
    
    @Html.Raw(headerScripts)
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* Hide scrollbar globally */
        * {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        *::-webkit-scrollbar {
            display: none;
        }

        :root {
            --primary: #FBBF24;
            --primary-dark: #F59E0B;
            --primary-light: #FEF3C7;
            --primary-glow: rgba(251, 191, 36, 0.4);
            
            --accent: #8B5CF6;
            --accent-light: #EDE9FE;
            
            --bg: #FAFAFA;
            --bg-card: #FFFFFF;
            --bg-elevated: #FFFFFF;
            --bg-dark: #0F172A;
            
            --text: #0F172A;
            --text-secondary: #475569;
            --text-muted: #94A3B8;
            
            --border: #E2E8F0;
            --border-light: #F1F5F9;
            
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            --info: #3B82F6;
            
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
            
            --radius: 12px;
            --radius-sm: 8px;
            --radius-lg: 16px;
            --radius-xl: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--text);
            background: var(--bg);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* ============================================
           HEADER - Glassmorphism Premium
        ============================================ */
        .header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        }

        .header-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            flex-shrink: 0;
            text-decoration: none;
        }

        .logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 4px 14px var(--primary-glow), inset 0 1px 1px rgba(255,255,255,0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .logo:hover .logo-icon {
            transform: scale(1.05) rotate(-3deg);
            box-shadow: 0 8px 20px var(--primary-glow), inset 0 1px 1px rgba(255,255,255,0.3);
        }

        .logo-text {
            font-size: 1.375rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--text) 0%, var(--text-secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.03em;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            margin-left: auto;
            background: var(--border-light);
            padding: 0.375rem;
            border-radius: var(--radius);
        }

        .nav-link {
            padding: 0.625rem 1.25rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-secondary);
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
            position: relative;
        }

        .nav-link:hover {
            color: var(--text);
        }

        .nav-link.active {
            background: var(--bg-card);
            color: var(--text);
            box-shadow: var(--shadow-sm);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .lang-switch {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-secondary);
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .lang-switch:hover {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }

        .lang-switch .flag {
            font-size: 1.125rem;
        }

        .mobile-menu-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            cursor: pointer;
            color: var(--text);
            font-size: 1.375rem;
            transition: all 0.2s ease;
        }

        .mobile-menu-btn:hover {
            border-color: var(--primary);
            background: var(--primary-light);
        }

        /* ============================================
           MAIN LAYOUT
        ============================================ */
        .main-layout {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 3rem;
            min-height: calc(100vh - 72px - 200px);
        }

        /* ============================================
           SIDEBAR - Modern Clean
        ============================================ */
        .sidebar {
            padding: 2rem 0;
            position: sticky;
            top: 88px;
            height: fit-content;
            max-height: calc(100vh - 110px);
            overflow-y: auto;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0 0 1.25rem;
            margin-bottom: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-header-icon {
            width: 32px;
            height: 32px;
            background: var(--primary-light);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .sidebar-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
        }

        .category-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .category-item {
            margin: 0;
        }

        .category-link {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-secondary);
            border-radius: var(--radius);
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .category-link:hover {
            background: var(--bg-card);
            border-color: var(--border);
            color: var(--text);
        }

        .category-link.active {
            background: linear-gradient(135deg, var(--primary-light) 0%, rgba(251, 191, 36, 0.15) 100%);
            border-color: var(--primary);
            color: var(--text);
        }

        .category-link.active .category-icon {
            transform: scale(1.1);
        }

        .category-icon {
            font-size: 1.25rem;
            width: 28px;
            text-align: center;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }

        .category-name {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .category-count {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-muted);
            background: var(--border-light);
            padding: 0.25rem 0.625rem;
            border-radius: 9999px;
            min-width: 28px;
            text-align: center;
        }

        .category-link.active .category-count {
            background: var(--primary);
            color: var(--text);
        }

        /* ============================================
           CONTENT AREA
        ============================================ */
        .content {
            padding: 2rem 0 4rem;
            min-width: 0;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 0.5rem;
            letter-spacing: -0.03em;
        }

        .page-description {
            font-size: 1rem;
            color: var(--text-secondary);
        }

        /* ============================================
           SEARCH BOX - Modern
        ============================================ */
        .search-section {
            margin-bottom: 2.5rem;
        }

        .search-box {
            display: flex;
            gap: 0.875rem;
            align-items: stretch;
        }

        .search-input-wrapper {
            flex: 1;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 1.125rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1.125rem;
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            padding: 1rem 1.25rem 1rem 3.25rem;
            font-size: 1rem;
            font-family: inherit;
            font-weight: 500;
            border: 2px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--bg-card);
            color: var(--text);
            outline: none;
            transition: all 0.2s ease;
        }

        .search-input::placeholder {
            color: var(--text-muted);
            font-weight: 400;
        }

        .search-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-light);
        }

        .search-btn {
            padding: 0 2rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: var(--text);
            font-size: 1rem;
            font-weight: 700;
            border: none;
            border-radius: var(--radius-lg);
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px var(--primary-glow);
        }

        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px var(--primary-glow);
        }

        .search-results {
            position: absolute;
            top: calc(100% + 0.75rem);
            left: 0;
            right: 0;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xl);
            z-index: 1000;
            display: none;
            max-height: 420px;
            overflow-y: auto;
        }

        .search-results.active {
            display: block;
            animation: slideDown 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .search-result-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
            transition: all 0.15s ease;
            cursor: pointer;
        }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .search-result-item:hover {
            background: var(--border-light);
        }

        .search-result-icon {
            width: 42px;
            height: 42px;
            background: var(--primary-light);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .search-result-content {
            flex: 1;
            min-width: 0;
        }

        .search-result-title {
            font-size: 0.9375rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.125rem;
        }

        .search-result-meta {
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .search-no-results,
        .search-loading {
            padding: 2rem;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9375rem;
        }

        /* ============================================
           FILTER BAR
        ============================================ */
        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title {
            font-size: 1.375rem;
            font-weight: 700;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-title::before {
            content: '';
            width: 4px;
            height: 24px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 9999px;
        }

        /* ============================================
           GUIDE CARDS - Premium Style
        ============================================ */
        .guide-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .guide-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .guide-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .guide-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }

        .guide-card:hover::before {
            transform: scaleX(1);
        }

        .guide-card-header {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .guide-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--primary-light) 0%, rgba(251, 191, 36, 0.2) 100%);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .guide-title-wrapper {
            flex: 1;
            min-width: 0;
        }

        .guide-category-tag {
            display: inline-block;
            padding: 0.375rem 0.75rem;
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-radius: 9999px;
            margin-bottom: 0.5rem;
            background: var(--primary-light);
            color: var(--primary-dark);
        }

        .guide-title {
            font-size: 1.0625rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.2s ease;
        }

        .guide-card:hover .guide-title {
            color: var(--primary-dark);
        }

        .guide-summary {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.7;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
            margin-bottom: 1.25rem;
        }

        .guide-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1rem;
            border-top: 1px solid var(--border-light);
            margin-top: auto;
        }

        .guide-stats {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .guide-stats-icon {
            font-size: 1rem;
        }

        .guide-arrow {
            width: 32px;
            height: 32px;
            background: var(--border-light);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            transition: all 0.2s ease;
        }

        .guide-card:hover .guide-arrow {
            background: var(--primary);
            color: var(--text);
            transform: translateX(4px);
        }

        /* ============================================
           FEATURED SECTION
        ============================================ */
        .featured-card {
            background: linear-gradient(135deg, #FFFBEB 0%, var(--primary-light) 50%, #FEF3C7 100%);
            border: 2px solid var(--primary);
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            margin-bottom: 2.5rem;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2.5rem;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .featured-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
            pointer-events: none;
        }

        .featured-content {
            position: relative;
            z-index: 1;
        }

        .featured-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            font-size: 0.75rem;
            font-weight: 700;
            background: var(--primary);
            color: var(--text);
            border-radius: 9999px;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 14px var(--primary-glow);
        }

        .featured-badge::before {
            content: '✨';
        }

        .featured-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 0.75rem;
            letter-spacing: -0.02em;
        }

        .featured-summary {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
            line-height: 1.7;
            max-width: 500px;
        }

        .featured-link {
            display: inline-flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.875rem 1.5rem;
            font-size: 0.9375rem;
            font-weight: 700;
            background: var(--bg-card);
            color: var(--text);
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            transition: all 0.2s ease;
        }

        .featured-link:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-2px);
        }

        .featured-image {
            width: 220px;
            height: 160px;
            border-radius: var(--radius-lg);
            object-fit: cover;
            background: var(--bg-card);
            border: 4px solid var(--bg-card);
            box-shadow: var(--shadow-lg);
            position: relative;
            z-index: 1;
        }

        /* ============================================
           GUIDE DETAIL
        ============================================ */
        .guide-content {
            max-width: 800px;
        }

        .guide-content h1 { 
            font-size: 2.25rem; 
            font-weight: 800; 
            margin-bottom: 1.25rem; 
            letter-spacing: -0.03em;
        }
        .guide-content h2 { 
            font-size: 1.625rem; 
            font-weight: 700; 
            margin: 2.5rem 0 1rem; 
            padding-bottom: 0.75rem; 
            border-bottom: 2px solid var(--border); 
            letter-spacing: -0.02em;
        }
        .guide-content h3 { 
            font-size: 1.375rem; 
            font-weight: 700; 
            margin: 2rem 0 0.875rem; 
        }
        .guide-content h4 { 
            font-size: 1.125rem; 
            font-weight: 600; 
            margin: 1.5rem 0 0.625rem; 
        }
        .guide-content p { margin-bottom: 1.25rem; }
        .guide-content ul, .guide-content ol { margin: 1.25rem 0; padding-left: 1.75rem; }
        .guide-content li { margin-bottom: 0.625rem; }
        .guide-content blockquote {
            margin: 1.75rem 0;
            padding: 1.25rem 1.75rem;
            background: var(--primary-light);
            border-left: 4px solid var(--primary);
            border-radius: 0 var(--radius) var(--radius) 0;
            font-style: italic;
        }
        .guide-content pre {
            margin: 1.75rem 0;
            padding: 1.25rem;
            background: var(--bg-dark);
            color: #E2E8F0;
            border-radius: var(--radius);
            overflow-x: auto;
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            font-size: 0.9rem;
        }
        .guide-content code {
            padding: 0.2rem 0.5rem;
            background: var(--border-light);
            border-radius: var(--radius-sm);
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            font-size: 0.875em;
        }
        .guide-content pre code {
            padding: 0;
            background: transparent;
        }
        .guide-content img {
            max-width: 100%;
            height: auto;
            border-radius: var(--radius);
            margin: 1.25rem 0;
        }
        .guide-content a {
            color: var(--primary-dark);
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-bottom: 1.75rem;
            font-weight: 500;
        }

        .breadcrumb a:hover {
            color: var(--primary-dark);
        }

        .breadcrumb-sep {
            color: var(--border);
        }

        .related-section {
            margin-top: 4rem;
            padding-top: 2.5rem;
            border-top: 2px solid var(--border);
        }

        .related-title {
            font-size: 1.375rem;
            font-weight: 700;
            margin-bottom: 1.75rem;
        }

        /* ============================================
           FOOTER - Modern Premium
        ============================================ */
        .footer {
            margin-top: 5rem;
            background: var(--bg-dark);
            color: #E2E8F0;
        }

        .footer-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 4rem 2rem 2rem;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .footer-logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .footer-logo-text {
            font-size: 1.25rem;
            font-weight: 800;
            color: #FFFFFF;
        }

        .footer-description {
            font-size: 0.9375rem;
            color: #94A3B8;
            line-height: 1.7;
        }

        .footer-social {
            display: flex;
            gap: 0.625rem;
            margin-top: 0.5rem;
        }

        .footer-social-link {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-sm);
            color: #94A3B8;
            transition: all 0.2s ease;
        }

        .footer-social-link:hover {
            background: var(--primary);
            color: var(--text);
        }

        .footer-section h4 {
            font-size: 0.9375rem;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 1.25rem;
        }

        .footer-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .footer-links a {
            font-size: 0.9375rem;
            color: #94A3B8;
            transition: all 0.2s ease;
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.875rem;
            color: #64748B;
        }

        .footer-bottom-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-bottom-links a {
            color: #64748B;
            transition: color 0.2s ease;
        }

        .footer-bottom-links a:hover {
            color: var(--primary);
        }

        /* ============================================
           COOKIE CONSENT
        ============================================ */
        .cookie-consent {
            display: none;
            position: fixed;
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-dark);
            color: #E2E8F0;
            padding: 1.25rem 2rem;
            z-index: 9999;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xl);
            max-width: 600px;
            width: calc(100% - 3rem);
        }

        .cookie-consent-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .cookie-consent-text {
            margin: 0;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .cookie-link {
            color: var(--primary);
            text-decoration: underline;
        }

        .cookie-buttons {
            display: flex;
            gap: 0.625rem;
        }

        .cookie-btn {
            padding: 0.625rem 1.25rem;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .cookie-btn-accept {
            background: var(--primary);
            color: var(--text);
        }

        .cookie-btn-accept:hover {
            background: var(--primary-dark);
        }

        .cookie-btn-decline {
            background: transparent;
            color: #94A3B8;
            border: 1px solid #475569;
        }

        .cookie-btn-decline:hover {
            border-color: #94A3B8;
            color: #E2E8F0;
        }

        /* ============================================
           RESPONSIVE
        ============================================ */
        @@media (max-width: 1024px) {
            .guide-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 900px) {
            .header-inner {
                padding: 0 1.25rem;
                height: 64px;
            }

            .nav {
                display: none;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .main-layout {
                grid-template-columns: 1fr;
                padding: 0 1.25rem;
                gap: 1.5rem;
            }

            .sidebar {
                position: relative;
                top: 0;
                display: none;
                padding: 1.25rem;
                background: var(--bg-card);
                border-radius: var(--radius-lg);
                margin-top: 1rem;
                border: 1px solid var(--border);
            }

            .sidebar.show {
                display: block;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                text-align: center;
            }

            .footer-brand {
                align-items: center;
            }

            .footer-social {
                justify-content: center;
            }

            .footer-links {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: center;
                gap: 1.25rem;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }

        @@media (max-width: 768px) {
            .guide-grid {
                grid-template-columns: 1fr;
            }

            .featured-card {
                grid-template-columns: 1fr;
                padding: 2rem;
            }

            .featured-image {
                width: 100%;
                height: 200px;
                order: -1;
            }

            .search-box {
                flex-direction: column;
            }

            .search-btn {
                padding: 1rem;
            }

            .filter-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 480px) {
            .header-inner {
                height: 60px;
            }

            .logo-text {
                display: none;
            }

            .page-title {
                font-size: 1.625rem;
            }

            .cookie-consent {
                bottom: 0;
                left: 0;
                right: 0;
                transform: none;
                border-radius: var(--radius-lg) var(--radius-lg) 0 0;
                width: 100%;
                max-width: 100%;
            }

            .cookie-consent-inner {
                flex-direction: column;
                text-align: center;
            }
        }

        .text-muted { color: var(--text-muted); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header">
        <div class="header-inner">
            <a href="@(isEnglish ? "/en" : "/")" class="logo">
                <div class="logo-icon">⚡</div>
                <span class="logo-text">@siteName</span>
            </a>
            
            <nav class="nav">
                <a href="@(isEnglish ? "/en" : "/")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    @(isEnglish ? "Home" : "Ana Sayfa")
                </a>
                <a href="@(isEnglish ? "/en/guides" : "/rehberler")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Guides" ? "active" : "")">
                    @(isEnglish ? "Guides" : "Rehberler")
                </a>
                <a href="@(isEnglish ? "/en/page/hakkinda" : "/sayfa/hakkinda")" class="nav-link">
                    @(isEnglish ? "About" : "Hakkında")
                </a>
            </nav>
            
            <div class="header-actions">
                @if (isEnglish)
                {
                    <a href="@(ViewBag.AlternateUrl ?? "/")" class="lang-switch">
                        <span class="flag">🇹🇷</span>
                        <span>Türkçe</span>
                    </a>
                }
                else
                {
                    <a href="@(ViewBag.AlternateUrl ?? "/en")" class="lang-switch">
                        <span class="flag">🇬🇧</span>
                        <span>English</span>
                    </a>
                }
                <button class="mobile-menu-btn" onclick="toggleSidebar()" aria-label="Menü">☰</button>
            </div>
        </div>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-content">
                <div class="footer-brand">
                    <a href="@(isEnglish ? "/en" : "/")" class="footer-logo">
                        <div class="footer-logo-icon">⚡</div>
                        <span class="footer-logo-text">@siteName</span>
                    </a>
                    <p class="footer-description">
                        @(isEnglish 
                            ? "Comprehensive guides on algorithms, data structures, and software architecture. Learn, practice, and master programming concepts."
                            : "Algoritmalar, veri yapıları ve yazılım mimarisi üzerine kapsamlı rehberler. Programlama kavramlarını öğrenin ve ustalaşın.")
                    </p>
                    <div class="footer-social">
                        <a href="https://x.com/algoritmauzmani" target="_blank" rel="noopener noreferrer" class="footer-social-link" title="X (Twitter)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a href="https://www.youtube.com/@@AlgoritmaUzman" target="_blank" rel="noopener noreferrer" class="footer-social-link" title="YouTube">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                        </a>
                        <a href="https://instagram.com/algoritmauzman" target="_blank" rel="noopener noreferrer" class="footer-social-link" title="Instagram">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                    </div>
                </div>
                
                <div class="footer-section">
                    <h4>@(isEnglish ? "Quick Links" : "Hızlı Bağlantılar")</h4>
                    <ul class="footer-links">
                        <li><a href="@(isEnglish ? "/en" : "/")">@(isEnglish ? "Home" : "Ana Sayfa")</a></li>
                        <li><a href="@(isEnglish ? "/en/guides" : "/rehberler")">@(isEnglish ? "Guides" : "Rehberler")</a></li>
                        <li><a href="@(isEnglish ? "/en/page/hakkinda" : "/sayfa/hakkinda")">@(isEnglish ? "About" : "Hakkında")</a></li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h4>@(isEnglish ? "Legal" : "Yasal")</h4>
                    <ul class="footer-links">
                        <li><a href="@(isEnglish ? "/en/page/gizlilik" : "/sayfa/gizlilik")">@(isEnglish ? "Privacy Policy" : "Gizlilik Politikası")</a></li>
                        <li><a href="@(isEnglish ? "/en/page/cerez-politikasi" : "/sayfa/cerez-politikasi")">@(isEnglish ? "Cookie Policy" : "Çerez Politikası")</a></li>
                        <li><a href="/sitemap.xml">Sitemap</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>@(isEnglish ? "Contact" : "İletişim")</h4>
                    <ul class="footer-links">
                        <li><a href="mailto:info@algoritmauzmani.com">info@algoritmauzmani.com</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year @siteName. @(isEnglish ? "All rights reserved." : "Tüm hakları saklıdır.")</span>
                <div class="footer-bottom-links">
                    @if (isEnglish)
                    {
                        <a href="@(ViewBag.AlternateUrl ?? "/")">🇹🇷 Türkçe</a>
                    }
                    else
                    {
                        <a href="@(ViewBag.AlternateUrl ?? "/en")">🇬🇧 English</a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <div id="cookieConsent" class="cookie-consent">
        <div class="cookie-consent-inner">
            <p class="cookie-consent-text">
                @(isEnglish 
                    ? "We use cookies to improve your experience." 
                    : "Deneyiminizi iyileştirmek için çerezler kullanıyoruz.")
                <a href="@(isEnglish ? "/en/page/cerez-politikasi" : "/sayfa/cerez-politikasi")" class="cookie-link">
                    @(isEnglish ? "Learn more" : "Daha fazla")
                </a>
            </p>
            <div class="cookie-buttons">
                <button onclick="acceptCookies()" class="cookie-btn cookie-btn-accept">
                    @(isEnglish ? "Accept" : "Kabul Et")
                </button>
                <button onclick="declineCookies()" class="cookie-btn cookie-btn-decline">
                    @(isEnglish ? "Decline" : "Reddet")
                </button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var consent = localStorage.getItem('cookieConsent');
            if (!consent) {
                document.getElementById('cookieConsent').style.display = 'block';
            }
        })();

        function acceptCookies() {
            localStorage.setItem('cookieConsent', 'accepted');
            document.getElementById('cookieConsent').style.display = 'none';
        }

        function declineCookies() {
            localStorage.setItem('cookieConsent', 'declined');
            document.getElementById('cookieConsent').style.display = 'none';
        }

        function toggleSidebar() {
            var sidebar = document.querySelector('.sidebar');
            if (sidebar) {
                sidebar.classList.toggle('show');
            }
        }

        document.addEventListener('click', function(e) {
            var sidebar = document.querySelector('.sidebar');
            var menuBtn = document.querySelector('.mobile-menu-btn');
            if (sidebar && sidebar.classList.contains('show')) {
                if (!sidebar.contains(e.target) && !menuBtn.contains(e.target)) {
                    sidebar.classList.remove('show');
                }
            }
        });

        (function() {
            var searchInput = document.getElementById('searchInput');
            var searchResults = document.getElementById('searchResults');
            var searchContainer = document.getElementById('searchContainer') || document.querySelector('.search-input-wrapper');
            var searchTimeout = null;
            var currentLang = '@language';
            var noResultsText = currentLang === 'en' ? 'No results found' : 'Sonuç bulunamadı';
            var loadingText = currentLang === 'en' ? 'Searching...' : 'Aranıyor...';

            if (!searchInput || !searchResults) return;

            searchInput.addEventListener('input', function() {
                var query = this.value.trim();

                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }

                if (query.length < 2) {
                    searchResults.classList.remove('active');
                    searchResults.innerHTML = '';
                    return;
                }

                searchResults.innerHTML = '<div class="search-loading">' + loadingText + '</div>';
                searchResults.classList.add('active');

                searchTimeout = setTimeout(function() {
                    fetch('/api/search?q=' + encodeURIComponent(query) + '&lang=' + currentLang)
                        .then(function(response) { return response.json(); })
                        .then(function(data) {
                            if (data.results && data.results.length > 0) {
                                var html = '';
                                data.results.forEach(function(item) {
                                    html += '<a href="' + item.url + '" class="search-result-item">' +
                                        '<div class="search-result-icon">' + (item.categoryIcon || '📚') + '</div>' +
                                        '<div class="search-result-content">' +
                                            '<div class="search-result-title">' + escapeHtml(item.title) + '</div>' +
                                            '<div class="search-result-meta">' + escapeHtml(item.category) + '</div>' +
                                        '</div>' +
                                    '</a>';
                                });
                                searchResults.innerHTML = html;
                            } else {
                                searchResults.innerHTML = '<div class="search-no-results">' + noResultsText + '</div>';
                            }
                        })
                        .catch(function() {
                            searchResults.innerHTML = '<div class="search-no-results">' + noResultsText + '</div>';
                        });
                }, 300);
            });

            document.addEventListener('click', function(e) {
                if (searchContainer && !searchContainer.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchResults.classList.remove('active');
                    searchInput.blur();
                }
            });

            function escapeHtml(text) {
                if (!text) return '';
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
    @if (!string.IsNullOrEmpty(googleTagManager))
    {
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@googleTagManager"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    }
    
    @{
        var footerScripts = await SiteSettingService.GetFooterScriptsAsync();
    }
    @Html.Raw(footerScripts)
</body>
</html>
