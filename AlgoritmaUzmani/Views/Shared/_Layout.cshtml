                <span class="logo-text">@siteName</span>
            </a>
            
            <nav class="nav">
                <a href="@(isEnglish ? "/en" : "/")" class="nav-link">
                    @(isEnglish ? "Home" : "Ana Sayfa")
                </a>
                <a href="@(isEnglish ? "/en/guides" : "/rehberler")" class="nav-link active">
                    @(isEnglish ? "Guide Catalog" : "Rehber Kataloğu")
                </a>
                <a href="@(isEnglish ? "/en/page/hakkinda" : "/sayfa/hakkinda")" class="nav-link">
                    @(isEnglish ? "About" : "Hakkında")
                </a>
            </nav>
            
            <div class="header-actions">
                @if (isEnglish)
                {
                    <a href="@(ViewBag.AlternateUrl ?? "/")" class="btn btn-ghost">🇹🇷 <span>Türkçe</span></a>
                }
                else
                {
                    <a href="@(ViewBag.AlternateUrl ?? "/en")" class="btn btn-ghost">🇬🇧 <span>English</span></a>
                }
