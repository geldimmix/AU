@model AlgoritmaUzmani.Models.ViewModels.Public.CategoryDetailViewModel
@{
    Layout = "_Layout";
    var isEnglish = Model.Language == "en";
    var categoryName = isEnglish && !string.IsNullOrEmpty(Model.Category.NameEn) ? Model.Category.NameEn : Model.Category.NameTr;
    var categoryDesc = isEnglish && !string.IsNullOrEmpty(Model.Category.DescriptionEn) ? Model.Category.DescriptionEn : Model.Category.DescriptionTr;
    var categorySlug = isEnglish && !string.IsNullOrEmpty(Model.Category.SlugEn) ? Model.Category.SlugEn : Model.Category.SlugTr;
    ViewData["Title"] = categoryName + (isEnglish ? " - Algorithm Expert" : " - Algoritma Uzmanı");
}

<div class="main-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-header-icon">☰</span>
            <span class="sidebar-title">@(isEnglish ? "Guide Catalog" : "Rehber Kataloğu")</span>
        </div>
        
        <div class="category-section open">
            <div class="category-section-title">
                <span>@(isEnglish ? "Categories" : "Kategoriler")</span>
                <span class="chevron">▼</span>
            </div>
            <ul class="category-list">
                @foreach (var category in Model.AllCategories)
                {
                    var catName = isEnglish && !string.IsNullOrEmpty(category.NameEn) ? category.NameEn : category.NameTr;
                    var catSlug = isEnglish && !string.IsNullOrEmpty(category.SlugEn) ? category.SlugEn : category.SlugTr;
                    var isActive = category.Id == Model.Category.Id;
                    var guideCount = category.Guides?.Count(g => g.IsActive) ?? 0;
                    <li class="category-item">
                        <a href="@(isEnglish ? "/en/guides/" : "/rehberler/")@catSlug" class="category-link @(isActive ? "active" : "")">
                            <span class="category-icon">@category.Icon</span>
                            <span class="category-name">@catName</span>
                            <span class="category-count">@guideCount</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </aside>

    <!-- Content -->
    <main class="content">
        <nav class="breadcrumb">
            <a href="@(isEnglish ? "/en" : "/")">@(isEnglish ? "Home" : "Ana Sayfa")</a>
            <span class="breadcrumb-sep">›</span>
            <a href="@(isEnglish ? "/en/guides" : "/rehberler")">@(isEnglish ? "Guides" : "Rehberler")</a>
            <span class="breadcrumb-sep">›</span>
            <span>@categoryName</span>
        </nav>

        <div class="page-header">
            <h1 class="page-title">@Model.Category.Icon @categoryName</h1>
            @if (!string.IsNullOrEmpty(categoryDesc))
            {
                <p class="page-description">@categoryDesc</p>
            }
        </div>

        <!-- Search Section -->
        <div class="search-section">
            <label class="search-label">@(isEnglish ? "Search in " + categoryName : categoryName + " içinde ara")</label>
            <div class="search-box">
                <div class="search-input-wrapper">
                    <span class="search-icon">🔍</span>
                    <input type="text" 
                           class="search-input" 
                           id="searchInput" 
                           placeholder="@(isEnglish ? "Search for Guides" : "Rehber ara...")"
                           autocomplete="off" />
                    <div class="search-results" id="searchResults"></div>
                </div>
                <button class="search-btn" onclick="document.getElementById('searchInput').focus()">
                    @(isEnglish ? "Search" : "Ara")
                </button>
            </div>
        </div>

        @if (Model.Guides.Any())
        {
            <div class="filter-bar">
                <h2 class="section-title">@(isEnglish ? "All Guides" : "Tüm Rehberler") (@Model.Guides.Count())</h2>
                <div class="filter-options">
                    <label class="filter-checkbox">
                        <input type="checkbox" id="showFeaturedOnly" />
                        @(isEnglish ? "Show Featured Only" : "Sadece Öne Çıkanlar")
                    </label>
                </div>
            </div>

            <div class="guide-grid" id="guideGrid">
                @foreach (var guide in Model.Guides)
                {
                    var title = isEnglish && !string.IsNullOrEmpty(guide.TitleEn) ? guide.TitleEn : guide.TitleTr;
                    var summary = isEnglish && !string.IsNullOrEmpty(guide.SummaryEn) ? guide.SummaryEn : guide.SummaryTr;
                    var guideSlug = isEnglish && !string.IsNullOrEmpty(guide.SlugEn) ? guide.SlugEn : guide.SlugTr;
                    var catIcon = Model.Category.Icon ?? "📚";

                    // Determine category color class
                    var catColorClass = "default";
                    var catNameLower = (Model.Category.NameTr ?? "").ToLower();
                    if (catNameLower.Contains("yapay zeka") || catNameLower.Contains("artificial")) catColorClass = "ai";
                    else if (catNameLower.Contains("veri") || catNameLower.Contains("data")) catColorClass = "data";
                    else if (catNameLower.Contains("güvenlik") || catNameLower.Contains("security")) catColorClass = "security";
                    else if (catNameLower.Contains("e-ticaret") || catNameLower.Contains("commerce")) catColorClass = "ecommerce";
                    else if (catNameLower.Contains("dosya") || catNameLower.Contains("file")) catColorClass = "file";
                    else if (catNameLower.Contains("görsel") || catNameLower.Contains("image")) catColorClass = "image";
                    else if (catNameLower.Contains("seo")) catColorClass = "seo";

                    <a href="@(isEnglish ? "/en/guides/" : "/rehberler/")@categorySlug/@guideSlug" class="guide-card" data-featured="@guide.IsFeatured.ToString().ToLower()">
                        <div class="guide-card-header">
                            <div class="guide-icon">@catIcon</div>
                            <div class="guide-title-wrapper">
                                <h3 class="guide-title">@title</h3>
                                @if (guide.IsFeatured)
                                {
                                    <span class="guide-badge featured">
                                        <span class="guide-badge-icon">⚡</span>
                                        @(isEnglish ? "FEATURED" : "ÖNE ÇIKAN")
                                    </span>
                                }
                            </div>
                        </div>
                        
                        <span class="guide-category-tag @catColorClass">@categoryName</span>
                        
                        @if (!string.IsNullOrEmpty(summary))
                        {
                            <p class="guide-summary">@summary</p>
                        }
                        
                        <div class="guide-footer">
                            <div class="guide-author">
                                <div class="guide-author-avatar">⚡</div>
                                <span class="guide-author-name">@(isEnglish ? "Algorithm Expert" : "Algoritma Uzmanı")</span>
                                <span class="guide-author-verified" title="@(isEnglish ? "Verified" : "Doğrulanmış")">✓</span>
                            </div>
                            <div class="guide-stats">
                                <span class="guide-stats-icon">👁</span>
                                @guide.ViewCount @(isEnglish ? "Views" : "Görüntüleme")
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 4rem 2rem; color: var(--text-light); background: var(--bg-soft); border-radius: 12px; margin-top: 2rem;">
                <p style="font-size: 4rem; margin-bottom: 1rem;">📝</p>
                <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem;">
                    @(isEnglish ? "No guides in this category yet" : "Bu kategoride henüz rehber yok")
                </h3>
                <p>@(isEnglish ? "Check back soon for new content!" : "Yakında yeni içerikler için tekrar kontrol edin!")</p>
            </div>
        }
    </main>
</div>

@section Scripts {
<script>
    // Category section toggle
    document.querySelectorAll('.category-section-title').forEach(function(title) {
        title.addEventListener('click', function() {
            this.parentElement.classList.toggle('open');
        });
    });

    // Featured filter
    document.getElementById('showFeaturedOnly')?.addEventListener('change', function() {
        var cards = document.querySelectorAll('.guide-card');
        var showFeatured = this.checked;
        
        cards.forEach(function(card) {
            if (showFeatured && card.dataset.featured !== 'true') {
                card.style.display = 'none';
            } else {
                card.style.display = '';
            }
        });
    });
</script>
}
